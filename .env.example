# 复制为 .env 后按需修改。已存在的系统环境变量优先于这里的值。

# 服务端口
MAC_PORT=18760

# 监听地址。0.0.0.0 允许同一局域网的手机访问；只想本机访问改成 127.0.0.1
MAC_HOST=0.0.0.0

# 访问口令。留空表示不需要口令；监听 0.0.0.0 时建议设置
MAC_TOKEN=

# 数据目录（SQLite 数据库所在位置），默认是项目下的 data/
# MAC_DATA_DIR=

# 模型密钥可以放在这里，然后在渠道的 API Key 里填 env:变量名，数据库里就只保存变量名
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DASHSCOPE_API_KEY=
